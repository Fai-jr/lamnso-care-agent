# Copy to .env and fill in. Never commit .env.
# true = run everything offline with clearly-labelled stand-ins (no Nightshift, no weights needed)
SAMPLE_MODE=true

# Meterless Nightshift (OpenAI-compatible). The token is written by the runtime; model ids are routing modes.
# If Nightshift runs on another computer (Mac/Windows) use that machine's LAN address, e.g. http://192.168.1.20:8088/v1
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
NIGHTSHIFT_TIMEOUT=180

# Zetaris (JDBC), wired in a later step
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_DRIVER_CLASS=com.zetaris.lightning.jdbc.LightningDriver
ZETARIS_JAR_PATH=/path/to/zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
ZETARIS_USER=your-user
ZETARIS_PASSWORD=your-password
# Must be inside the platform's local file-system root (customer-data/shared); setup_zetaris.py creates it
ZETARIS_STORAGE_PATH=/home/zetaris/customer-data/shared/lamnso-lakehouse

# Translation model
TRANSLATION_WEIGHTS_PATH=translation/weights/best_model.pt

# Logging: message text is never written unless this is true (use only with synthetic demo data)
LOG_CONTENT=false

# H-MEM (Meterless memory engine), run locally: npm --prefix engines/hmem run serve
HMEM_URL=http://127.0.0.1:8765
# Optional shared secret between the backend and the memory service (set the same value for both)
HMEM_TOKEN=
